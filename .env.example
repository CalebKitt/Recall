# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Neon: Dashboard -> Connection Details -> copy the POOLED connection string.
# Local Postgres: postgresql://postgres:postgres@localhost:5432/recall
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Connection pool size. The bundled dev database (scripts/dev-db.mjs) accepts
# only one connection at a time, so set this to 1 when using it.
# DB_POOL_MAX="10"
# Seconds before an idle connection is closed. Set to 0 with the dev database.
# DB_IDLE_TIMEOUT="20"

# --- Auth.js (required) ----------------------------------------------------
# Generate with:  npx auth secret        (or: openssl rand -base64 32)
AUTH_SECRET=""

# Only needed for local dev if the port is not 3000. In production set this to
# your real origin, e.g. https://recall.vercel.app
# NEXTAUTH_URL="http://localhost:3000"

# --- Encryption for stored per-user API keys (required) --------------------
# 32 bytes of hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes any already-stored personal API keys unreadable.
ENCRYPTION_KEY=""

# --- Google sign-in --------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#                     and: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Microsoft sign-in (optional) -----------------------------------------
# Entra admin centre -> App registrations -> New registration.
# Redirect URI (Web): http://localhost:3000/api/auth/callback/microsoft-entra-id
# Leave these blank and the Microsoft button simply won't appear.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Tenant issuer. Use "common" for any Microsoft account, or your tenant GUID.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# --- Gemini (optional) -----------------------------------------------------
# Shared fallback key used when a user has not supplied their own in Settings.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional override. Leave unset to use the default in src/lib/gemini.ts.
# GEMINI_MODEL="gemini-3.6-flash"
# Used automatically when the main model is overloaded, rate limited or retired.
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
